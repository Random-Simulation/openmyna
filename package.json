    "deploy-site": "wrangler pages deploy static/ --project-name=openmyna"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.33.0"
  }
}
